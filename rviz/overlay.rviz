Panels:
  - Class: test_traj_panel/TestTrajPanel
    Name: Test Trajectory
Visualization Manager:
  Displays:
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: TestTrajPath
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test_traj_panel/path
      Value: true
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz_default_plugins/Pose
      Color: 255; 85; 0
      Enabled: true
      Head Length: 0.2
      Head Radius: 0.08
      Name: TestTrajTarget
      Shaft Length: 0.4
      Shaft Radius: 0.04
      Shape: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curent_target
      Value: true
